# =========================================================
# Kiosco Virtual / Coffee Shop - Equipo 8 (Octava Café)
# Copiar este archivo como ".env" y completar los valores.
# El archivo .env NUNCA se sube a GitHub (ver .gitignore).
# =========================================================

# Configuración de Base de Datos MySQL (XAMPP por defecto)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kiosco_online
DB_USER=root
DB_PASS=

# Credenciales de Mercado Pago (Modo Sandbox / Prueba o Producción)
# Obtenerlas en: https://www.mercadopago.com.ar/developers/panel/credentials
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# URL base del proyecto (sin barra final).
# Si se deja vacía, se autodetecta según la carpeta dentro de htdocs.
BASE_URL=http://localhost/ariza
